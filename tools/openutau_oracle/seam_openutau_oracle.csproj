<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SeamOpenUtauOracle</RootNamespace>
    <AssemblyName>seam_openutau_oracle</AssemblyName>
  </PropertyGroup>

  <!-- Point this at a checkout of https://github.com/openutau/OpenUtau at the commit named in
       README.md. The oracle is only meaningful if the checkout is pinned; an unpinned one can
       change what "OpenUtau accepts" means without anyone noticing. -->
  <ItemGroup>
    <ProjectReference Include="$(OpenUtauRoot)/OpenUtau.Core/OpenUtau.Core.csproj" />
  </ItemGroup>

</Project>

