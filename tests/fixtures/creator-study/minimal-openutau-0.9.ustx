ustx_version: "0.9"
name: Creator Study Round Trip
comment: "Study-only fixture"
output_dir: Vocal
cache_dir: UCache
expressions: {}
exp_selectors: [dyn, pitd, clr, eng, vel, vol, atk, dec, gen, bre]
exp_primary: 0
exp_secondary: 1
key: 0
time_signatures:
  - {bar_position: 0, beat_per_bar: 4, beat_unit: 4}
tempos:
  - {position: 0, bpm: 120}
  - {position: 480, bpm: 150}
tracks:
  - singer: study-singer
    track_name: Lead
    track_color: Blue
    mute: false
    solo: false
    volume: -3
    pan: 0.25
    track_expressions: []
    voice_color_names: [""]
voice_parts:
  - name: Verse
    comment: ""
    track_no: 0
    position: 0
    duration: 960
    curves: []
    notes:
      - position: 0
        duration: 480
        tone: 60
        lyric: "あ"
        pitch:
          data:
            - {x: 0, y: 0, shape: l}
            - {x: 250, y: 5, shape: io}
          snap_first: true
        vibrato: {length: 60, period: 175, depth: 25, in: 10, out: 10, shift: 0, drift: 0, vol_link: 0}
        tuning: 0
        phoneme_expressions: []
        phoneme_overrides: []
      - position: 480
        duration: 480
        tone: 62
        lyric: "い"
        pitch:
          data:
            - {x: 0, y: 0, shape: l}
            - {x: 200, y: -3, shape: l}
          snap_first: true
        vibrato: {length: 0, period: 175, depth: 25, in: 10, out: 10, shift: 0, drift: 0, vol_link: 0}
        tuning: 0
        phoneme_expressions: []
        phoneme_overrides: []
