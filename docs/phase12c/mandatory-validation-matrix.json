  "releaseGates": {
    "G2_FEATURE_COMPLETE": {
      "requiresPhase12cLinuxValidation": true
    },
    "G3_BETA": {
      "requiredOperatingSystems": ["windows-11-x64", "macos-apple-silicon"],
      "requiredHosts": ["reaper", "bitwig-studio", "logic-pro"]
    },
    "G4_RELEASE_CANDIDATE": {
      "allDeclaredSupportedHostsMustPass": true,
      "signingAndNotarizationMustPass": true,
      "cleanOsInstallerMustPass": true,
      "declaredFormatValidatorsMustPass": true
    },
    "G5_GENERAL_AVAILABILITY": {
      "officialVoicebankAcceptanceMustPass": true,
      "unresolvedMandatoryValidationCount": 0
    }
  }
