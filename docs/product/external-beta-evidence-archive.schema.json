{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-seam.invalid/schemas/external-beta-evidence-archive.schema.json",
  "title": "Project SEAM External Beta restored evidence archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "archiveId", "candidateRootId", "status", "anchored", "immutable", "anchor", "createdAt", "roles", "entries", "manifestSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordType": {"const": "external-beta-evidence-archive"},
    "archiveId": {"type": "string", "minLength": 1},
    "candidateRootId": {"type": "string", "minLength": 1},
    "status": {"const": "SEALED"},
    "anchored": {"const": true},
    "immutable": {"const": true},
    "anchor": {"type": "object", "required": ["kind", "locator", "sha256"], "properties": {"kind": {"type": "string"}, "locator": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "createdAt": {"type": "string", "format": "date-time"},
    "roles": {"type": "object", "required": ["producer", "reviewer"], "properties": {"producer": {"enum": ["A3", "A4", "A5", "A6"]}, "reviewer": {"enum": ["A3", "A4", "A5", "A6"]}}},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "kind", "privacyClass", "sha256", "size"], "properties": {"path": {"type": "string"}, "kind": {"type": "string"}, "privacyClass": {"enum": ["PUBLIC_TECHNICAL", "RESTRICTED_SUPPORT", "PRIVATE_LOCAL"]}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 1}}}},
    "manifestSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
}
