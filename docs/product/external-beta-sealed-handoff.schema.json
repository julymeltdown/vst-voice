{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-seam.invalid/schemas/external-beta-sealed-handoff-1.json",
  "title": "Project SEAM External Beta sealed installer handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "purpose", "candidateId", "manifestSha256", "package", "requiresExplicitUserAction", "requiresInstallerRevalidation", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "purpose": {"const": "sealed-installer-handoff"},
    "candidateId": {"type": "string", "pattern": "^candidate-[A-Fa-f0-9]{32}$"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "relativePath", "size", "sha256", "device", "inode"],
      "properties": {
        "fileName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "relativePath": {"type": "string", "pattern": "^candidate-[A-Fa-f0-9]{32}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "size": {"type": "integer", "minimum": 1, "maximum": 8589934592},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0}
      }
    },
    "requiresExplicitUserAction": {"const": true},
    "requiresInstallerRevalidation": {"const": true},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
