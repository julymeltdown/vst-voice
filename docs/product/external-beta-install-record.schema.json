{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-seam.invalid/schemas/external-beta-install-record.schema.json",
  "title": "Project SEAM External Beta clean-install lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "status", "recordId", "platform", "architecture", "osBuild", "imageId", "accountAuthority", "candidateRootId", "deliverableSha256", "installerSha256", "installedTreeSha256", "bankIdentity", "acquisition", "clockAuthority", "operator", "verifier", "startedAt", "endedAt", "inventory", "rows"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordType": {"const": "external-beta-install-lifecycle"},
    "status": {"enum": ["NOT_RUN", "BLOCKED", "FAIL", "PASS"]},
    "recordId": {"type": "string", "minLength": 1},
    "platform": {"enum": ["macos", "windows"]},
    "architecture": {"enum": ["arm64", "x86_64"]},
    "osBuild": {"type": "string", "minLength": 1},
    "imageId": {"type": "string", "minLength": 1},
    "accountAuthority": {"const": "clean-verifier-snapshot"},
    "candidateRootId": {"type": "string", "minLength": 1},
    "deliverableSha256": {"$ref": "#/$defs/sha256"},
    "installerSha256": {"$ref": "#/$defs/sha256"},
    "installedTreeSha256": {"$ref": "#/$defs/sha256"},
    "bankIdentity": {"type": "object", "required": ["id", "version", "contentSha256", "installedProvenanceTreeSha256"], "properties": {"id": {"pattern": "^beta\\."}, "version": {"type": "string"}, "contentSha256": {"$ref": "#/$defs/sha256"}, "installedProvenanceTreeSha256": {"$ref": "#/$defs/sha256"}}},
    "acquisition": {"type": "object", "required": ["channel", "envelopeManifestSha256", "networkDisabledAfterAcquisition"], "properties": {"channel": {"type": "string"}, "envelopeManifestSha256": {"$ref": "#/$defs/sha256"}, "networkDisabledAfterAcquisition": {"const": true}}},
    "clockAuthority": {"const": "physical-device-clock"},
    "operator": {"type": "string", "minLength": 1},
    "verifier": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "endedAt": {"type": "string", "format": "date-time"},
    "inventory": {"type": "object", "required": ["preInstallSha256", "postInstallSha256", "postUninstallSha256", "preservedUserDataCanaries", "residualOwnedCode"], "properties": {"preInstallSha256": {"$ref": "#/$defs/sha256"}, "postInstallSha256": {"$ref": "#/$defs/sha256"}, "postUninstallSha256": {"$ref": "#/$defs/sha256"}, "preservedUserDataCanaries": {"const": true}, "residualOwnedCode": {"const": false}}},
    "rows": {"type": "array", "minItems": 12, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "capturedAt", "reviewer"], "properties": {"kind": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "capturedAt": {"type": "string", "format": "date-time"}, "reviewer": {"type": "string"}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["id", "status", "preInventorySha256", "postInventorySha256", "evidence"], "properties": {"id": {"pattern": "^INSTALL-[0-9]{3}$"}, "status": {"const": "PASS"}, "preInventorySha256": {"$ref": "#/$defs/sha256"}, "postInventorySha256": {"$ref": "#/$defs/sha256"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}}
  }
}
