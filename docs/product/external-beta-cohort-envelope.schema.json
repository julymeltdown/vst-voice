{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project SEAM External Beta offline cohort envelope",
  "type": "object",
  "required": ["schemaVersion", "candidateRootId", "platform", "members", "manifestSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "candidateRootId": {"type": "string", "minLength": 1},
    "platform": {"enum": ["macos", "windows"]},
    "members": {"type": "array", "minItems": 1},
    "manifestSha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}
