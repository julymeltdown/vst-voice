{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-seam.invalid/schemas/external-beta-update-trust-policy-1.json",
  "title": "Project SEAM External Beta update trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "purpose", "channel", "policyEpoch", "rootKeyId", "rootPublicKey", "allowedPlatforms", "issuedAt", "notBefore", "expiresAt", "compromiseCutoff", "delegatedKeys", "signature"],
  "properties": {
    "schemaVersion": {"const": 1},
    "purpose": {"const": "update-trust-policy"},
    "channel": {"const": "external-beta"},
    "policyEpoch": {"type": "integer", "minimum": 0},
    "rootKeyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "rootPublicKey": {"type": "string", "contentEncoding": "base64", "minLength": 44, "maxLength": 44},
    "allowedPlatforms": {"type": "array", "items": {"enum": ["macos-arm64", "windows-x64", "linux-x64"]}, "uniqueItems": true, "minItems": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "notBefore": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "compromiseCutoff": {"type": "string", "format": "date-time"},
    "delegatedKeys": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/delegatedKey"}},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "payloadSha256", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "keyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "payloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "value": {"type": "string", "contentEncoding": "base64", "minLength": 88, "maxLength": 88}
      }
    },
    "delegatedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "purpose", "algorithm", "publicKey", "notBefore", "expiresAt"],
      "properties": {
        "keyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "purpose": {"enum": ["update", "update-recovery"]},
        "algorithm": {"const": "Ed25519"},
        "publicKey": {"type": "string", "contentEncoding": "base64", "minLength": 44, "maxLength": 44},
        "notBefore": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "revokedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
