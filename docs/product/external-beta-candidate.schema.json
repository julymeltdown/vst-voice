{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project SEAM External Beta candidate root",
  "type": "object",
  "required": ["schemaVersion", "acceptanceContractSha256", "candidateRoot"],
  "properties": {
    "schemaVersion": {"const": 1},
    "acceptanceContractSha256": {"pattern": "^[0-9a-fA-F]{64}$"},
    "candidateRoot": {
      "type": "object",
      "required": ["id", "candidateId", "status", "sha256", "acceptanceContractSha256", "nodes", "edges"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "candidateId": {"type": "string", "minLength": 1},
        "status": {"const": "SEALED"},
        "sha256": {"pattern": "^[0-9a-f]{64}$"},
        "acceptanceContractSha256": {"pattern": "^[0-9a-fA-F]{64}$"},
        "nodes": {"type": "array", "minItems": 1},
        "edges": {"type": "array", "minItems": 1}
      }
    }
  }
}
