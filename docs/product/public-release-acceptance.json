  "requirements": [
    {"id": "PR-001-contract", "title": "Public contract and exact release identity", "gate": "docs/product/public-release-acceptance.json", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-002-root-chain", "title": "FreezeRoot, ArtifactRoot, and EvidenceRoot coherence", "gate": "tools/public_release/release_gate.py", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-003-external-beta-closed", "title": "Same-lineage External Beta closure", "gate": "docs/product/external-beta-acceptance.json", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-004-public-documents", "title": "Public document identity, digest, acceptance, and reacceptance", "gate": "docs/public", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-005-signed-artifacts", "title": "Signed macOS, Windows, and bank descendants", "gate": "tools/public_release/release_gate.py", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-006-clean-installed", "title": "Independent clean-installed trees", "gate": "tools/public_release/release_gate.py", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-007-bank-ready", "title": "Rights, musical, signed-package, and installed-bank identity", "gate": "tools/public_release/release_gate.py", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-008-target-matrices", "title": "Apple Silicon UA and separate Windows PW target matrices", "gate": "docs/product/public-windows-standalone-acceptance.json", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-009-update-channel", "title": "Signed public update, pause, repair, supersede, and revoke channel", "gate": "tools/public_release/release_gate.py", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-010-support-intake", "title": "Operated support intake through retention or deletion", "gate": "docs/public/SUPPORT.md", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-011-incident-drill", "title": "Candidate-bound public incident drill", "gate": "docs/public/SECURITY_RESPONSE.md", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-012-archive-restore", "title": "Restored immutable archive and raw evidence hashes", "gate": "scripts/run_public_release_audit.py", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-013-approvals", "title": "Ed25519 quorum and role separation outside EvidenceRoot", "gate": "tools/public_release/release_gate.py", "mandatoryFor": ["PUBLIC_ACTIVE"]},
    {"id": "PR-014-rollback-revoke", "title": "Verified rollback and irreversible separate-candidate revoke rehearsal", "gate": "tools/public_release/release_gate.py", "mandatoryFor": ["PUBLIC_ACTIVE"]}
  ],
