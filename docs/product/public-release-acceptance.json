    {"from": "DRAFT", "action": "AUTHORIZE_FREEZE", "to": "AUTHORIZED_FROZEN"},
    {"from": "AUTHORIZED_FROZEN", "action": "MARK_SIGNED", "to": "SIGNED"},
    {"from": "SIGNED", "action": "MARK_CLEAN_INSTALLED", "to": "CLEAN_INSTALLED"},
    {"from": "CLEAN_INSTALLED", "action": "MARK_BANK_READY", "to": "BANK_READY"},
    {"from": "BANK_READY", "action": "MARK_EVIDENCE_PASSED", "to": "EVIDENCE_PASSED"},
    {"from": "EVIDENCE_PASSED", "action": "MARK_EXTERNAL_BETA_READY", "to": "EXTERNAL_BETA_READY"},
    {"from": "EXTERNAL_BETA_READY", "action": "MARK_EXTERNAL_BETA_CLOSED", "to": "EXTERNAL_BETA_CLOSED"},
    {"from": "EXTERNAL_BETA_CLOSED", "action": "ACTIVATE", "to": "PUBLIC_ACTIVE"},
    {"from": "PUBLIC_ACTIVE", "action": "PAUSE", "to": "DISTRIBUTION_PAUSED"},
    {"from": "DISTRIBUTION_PAUSED", "action": "RESUME", "to": "PUBLIC_ACTIVE", "requiresFreshQuorum": true},
    {"from": "PUBLIC_ACTIVE", "action": "SUPERSEDE", "to": "SUPERSEDED"},
    {"from": "DISTRIBUTION_PAUSED", "action": "SUPERSEDE", "to": "SUPERSEDED"},
    {"from": "DRAFT", "action": "REVOKE", "to": "REVOKED"},
    {"from": "AUTHORIZED_FROZEN", "action": "REVOKE", "to": "REVOKED"},
    {"from": "SIGNED", "action": "REVOKE", "to": "REVOKED"},
    {"from": "CLEAN_INSTALLED", "action": "REVOKE", "to": "REVOKED"},
    {"from": "BANK_READY", "action": "REVOKE", "to": "REVOKED"},
    {"from": "EVIDENCE_PASSED", "action": "REVOKE", "to": "REVOKED"},
    {"from": "EXTERNAL_BETA_READY", "action": "REVOKE", "to": "REVOKED"},
    {"from": "EXTERNAL_BETA_CLOSED", "action": "REVOKE", "to": "REVOKED"},
    {"from": "PUBLIC_ACTIVE", "action": "REVOKE", "to": "REVOKED"},
    {"from": "DISTRIBUTION_PAUSED", "action": "REVOKE", "to": "REVOKED"},
    {"from": "SUPERSEDED", "action": "REVOKE", "to": "REVOKED"}
