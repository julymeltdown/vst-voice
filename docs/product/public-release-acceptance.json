  "schemaVersion": 1,
  "contractId": "project-seam.public-release.acceptance",
  "contractVersion": "1.0.0",
  "product": "Project SEAM",
  "channel": "public-direct-download",
  "states": [
    "DRAFT",
    "AUTHORIZED_FROZEN",
    "SIGNED",
    "CLEAN_INSTALLED",
    "BANK_READY",
    "EVIDENCE_PASSED",
    "EXTERNAL_BETA_READY",
    "EXTERNAL_BETA_CLOSED",
    "PUBLIC_ACTIVE",
    "DISTRIBUTION_PAUSED",
    "SUPERSEDED",
