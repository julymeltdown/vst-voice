{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-seam.invalid/schemas/external-beta-wrapper-manifest-1.json",
  "title": "Project SEAM External Beta projected wrapper manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "format", "platform", "architecture", "canonicalClapSha256", "wrapperTreeSha256", "bundleIdentifier", "version", "packageShape", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "Project SEAM"},
    "format": {"enum": ["VST3", "AUv2"]},
    "platform": {"enum": ["macos", "windows", "linux"]},
    "architecture": {"type": "string", "minLength": 1},
    "canonicalClapSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wrapperTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundleIdentifier": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "packageShape": {"enum": ["macos-vst3-bundle", "macos-auv2-component", "windows-vst3-folder", "linux-vst3-bundle"]},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 1}}}}
  }
}
