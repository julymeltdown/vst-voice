{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-seam.invalid/schemas/external-beta-build-manifest.schema.json",
  "title": "Project SEAM External Beta path-independent unsigned build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "architecture", "status", "signed", "sourceCommit", "manifestSha256", "treeSha256"],
  "properties": {
    "platform": {"enum": ["macos", "windows"]},
    "architecture": {"enum": ["arm64", "x64", "x86_64"]},
    "status": {"const": "PASS"},
    "signed": {"const": false},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "treeSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "artifactSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "dependencyCommits": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "toolchain": {"type": "object"},
    "workloadId": {"type": "string"},
    "workloadSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  }
}
