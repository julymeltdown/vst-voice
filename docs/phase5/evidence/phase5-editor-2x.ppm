$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &# &