 '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ '$ 'ЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄMtЄ