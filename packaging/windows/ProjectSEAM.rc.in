#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/packaging/windows/ProjectSEAM.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Project SEAM\0"
      VALUE "FileDescription", "Project SEAM standalone editor\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "seam_editor_native.exe\0"
      VALUE "OriginalFilename", "seam_editor_native.exe\0"
      VALUE "ProductName", "Project SEAM\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
      VALUE "ProjectSEAMBuildID", "@SEAM_BUILD_ID@\0"
      VALUE "ProjectSEAMSourceCommit", "@SEAM_SOURCE_COMMIT@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
